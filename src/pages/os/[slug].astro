---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import OsIcon from '../../components/OsIcon.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import { getCollection, getEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('os');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const toolEntries = await getCollection('tools');
const bundledTools = toolEntries.filter((t) => data.notableTools.includes(t.data.name));

const TAG_CLASS = 'inline-block rounded-full bg-gray-800 px-3 py-1 text-xs text-gray-300 mr-2';
const SOURCE_LINK_CLASS =
  'inline-flex items-center gap-1 rounded-md border border-gray-700 px-3 py-1.5 text-sm text-gray-200 no-underline transition-colors hover:border-emerald-500 hover:text-emerald-400';
---

<BaseLayout title={data.name} description={data.tagline}>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Operating Systems', href: '/os' }, { label: data.name }]} />
  <div class="flex items-center gap-4">
    <OsIcon slug={entry.id} category={data.category} size="lg" />
    <div>
      <h1 class="text-3xl font-bold text-white">{data.name}</h1>
      <p class="mt-1 text-gray-300">{data.tagline}</p>
    </div>
  </div>
  <div class="mt-3">
    <span class={TAG_CLASS}>{data.category}</span>
    <span class={TAG_CLASS}>based on {data.basedOn}</span>
  </div>

  {data.toolListMaintenance === 'manual' && (
    <div class="mt-4 flex items-start gap-2 rounded-lg border border-amber-800/60 bg-amber-950/40 px-4 py-3 text-sm text-amber-200" role="note">
      <span aria-hidden="true">⚠</span>
      <p>
        {data.name} has no official, structured tool listing we can auto-sync
        (unlike Kali, BlackArch, REMnux, and Tails). The tools below are
        maintained by hand and may be incomplete or outdated — check the{' '}
        <a class="underline hover:text-amber-100" href={data.docsUrl} rel="noopener noreferrer" target="_blank">official docs</a>{' '}
        for the current tool set.
      </p>
    </div>
  )}

  <div class="mt-5 flex flex-wrap gap-3">
    <a class={SOURCE_LINK_CLASS} href={data.docsUrl} rel="noopener noreferrer" target="_blank">Official docs ↗</a>
    {data.downloadUrl && (
      <a class={SOURCE_LINK_CLASS} href={data.downloadUrl} rel="noopener noreferrer" target="_blank">Download ↗</a>
    )}
    {data.repoUrl && (
      <a class={SOURCE_LINK_CLASS} href={data.repoUrl} rel="noopener noreferrer" target="_blank">Source repo ↗</a>
    )}
  </div>
  <p class="mt-3 text-sm text-gray-500">Last verified {data.lastVerified.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</p>

  <div class="mt-6 text-gray-300 leading-relaxed [&>p]:mb-4">
    <Content />
  </div>

  {bundledTools.length > 0 && (
    <>
      <h2 class="mt-8 text-xl font-semibold text-white">
        Notable bundled tools{data.toolListMaintenance === 'manual' && <span class="ml-2 align-middle text-xs font-normal uppercase tracking-wide text-amber-400">manually maintained</span>}
      </h2>
      <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3">
        {bundledTools.map((tool) => (
          <a
            class="card block rounded-lg border border-gray-800 bg-gray-900 p-5 no-underline transition-colors hover:border-emerald-500"
            href={`/tools/${tool.id}`}
          >
            <div class="mb-3 flex items-center gap-3">
              <ToolIcon slug={tool.id} category={tool.data.categories} />
              <h3 class="font-semibold text-white">{tool.data.name}</h3>
            </div>
            <p class="text-sm text-gray-400">{tool.data.tagline}</p>
          </a>
        ))}
      </div>
    </>
  )}

  <h2 class="mt-8 text-xl font-semibold text-white">Getting started</h2>
  <p class="getting-started mt-3 text-gray-300 leading-relaxed">{data.gettingStarted}</p>
</BaseLayout>
