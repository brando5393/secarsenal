---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import OsIcon from '../../components/OsIcon.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('os');
const categories = [...new Set(entries.map((e) => e.data.category))].sort();

const TEAM_LABELS: Record<string, string> = { red: 'Red Team', blue: 'Blue Team' };
const TEAM_BADGE_CLASSES: Record<string, string> = {
  red: 'bg-red-950/60 text-red-400',
  blue: 'bg-blue-950/60 text-blue-400',
};
---

<BaseLayout title="Operating Systems">
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Operating Systems' }]} />
  <h1 class="text-3xl font-bold text-white">Operating Systems</h1>
  <p class="mt-3 text-gray-300">Pentesting-focused Linux distributions, with what they're built on and how to get started.</p>

  <input
    id="os-name-filter"
    class="mt-4 w-full rounded-lg border border-gray-700 bg-gray-900 px-3 py-2.5 text-gray-100 placeholder-gray-500 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500"
    type="search"
    placeholder="Search by name or description…"
    aria-label="Search operating systems"
  />

  <div class="mt-4 flex flex-wrap gap-2" id="filter-bar" data-default="all">
    <button
      type="button"
      aria-pressed="true"
      data-category="all"
      class="rounded-full border border-gray-700 bg-gray-900 px-3 py-1.5 text-sm text-gray-300 transition-colors aria-pressed:border-emerald-500 aria-pressed:text-white"
      >All</button
    >
    {categories.map((c) => (
      <button
        type="button"
        aria-pressed="false"
        data-category={c}
        class="rounded-full border border-gray-700 bg-gray-900 px-3 py-1.5 text-sm text-gray-300 transition-colors aria-pressed:border-emerald-500 aria-pressed:text-white"
        >{c}</button
      >
    ))}
  </div>

  <div class="mt-2 flex flex-wrap items-center gap-2" id="team-filter-bar" data-default="all">
    <span class="mr-1 text-xs uppercase tracking-wide text-gray-400">Team</span>
    <button
      type="button"
      aria-pressed="true"
      data-team="all"
      class="rounded-full border border-gray-700 bg-gray-900 px-3 py-1.5 text-sm text-gray-300 transition-colors aria-pressed:border-emerald-500 aria-pressed:text-white"
      >All</button
    >
    {(['red', 'blue'] as const).map((t) => (
      <button
        type="button"
        aria-pressed="false"
        data-team={t}
        class="rounded-full border border-gray-700 bg-gray-900 px-3 py-1.5 text-sm text-gray-300 transition-colors aria-pressed:border-emerald-500 aria-pressed:text-white"
        >{TEAM_LABELS[t]}</button
      >
    ))}
  </div>
  <p class="mt-1 text-xs text-gray-400">
    Team is a hand-judged classification by primary use (offense vs. defense) — not every entry fits a team (privacy tools like Tails or Whonix aren't shown under any team filter). See the <a href="/categories#team-classification" class="underline hover:text-gray-300">Category Key</a> for how this is defined.
  </p>

  <p id="os-result-count" class="mt-3 text-sm text-gray-400"></p>

  <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3" id="card-grid">
    {entries.map((entry) => (
      <a
        class="card block rounded-lg border border-gray-800 bg-gray-900 p-5 no-underline transition-colors hover:border-emerald-500"
        href={`/os/${entry.id}`}
        data-category={entry.data.category}
        data-team={entry.data.team ?? ''}
        data-name={entry.data.name.toLowerCase()}
      >
        <div class="mb-3 flex items-center gap-3">
          <OsIcon slug={entry.id} category={entry.data.category} />
          <h3 class="font-semibold text-white">{entry.data.name}</h3>
        </div>
        <p class="text-sm text-gray-400">{entry.data.tagline}</p>
        <span class="mt-2 inline-block rounded-full bg-gray-800 px-3 py-1 text-xs text-gray-300">{entry.data.category}</span>
        {entry.data.team && (
          <span class={`mt-2 ml-2 inline-block rounded-full px-3 py-1 text-xs ${TEAM_BADGE_CLASSES[entry.data.team]}`}>{TEAM_LABELS[entry.data.team]}</span>
        )}
        {entry.data.toolListMaintenance === 'manual' && (
          <span class="mt-2 ml-2 inline-block rounded-full bg-amber-950/60 px-3 py-1 text-xs text-amber-300" title="No official structured tool listing to auto-sync — tools are hand-maintained">⚠ manual tools</span>
        )}
      </a>
    ))}
  </div>
</BaseLayout>
