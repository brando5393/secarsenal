---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not Found" description="This page doesn't exist on SecArsenal.">
  <div class="flex flex-col items-center py-16 text-center">
    <p class="font-mono text-sm uppercase tracking-widest text-emerald-400">404</p>
    <h1 class="mt-2 text-3xl font-bold text-white">Target not found</h1>
    <p class="mt-3 max-w-md text-gray-300">
      Nothing's listening on this path. The page may have moved, or the link
      might be out of date — try one of these instead:
    </p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a
        class="rounded-md bg-emerald-500 px-4 py-2 text-sm font-semibold text-gray-950 no-underline transition-colors hover:bg-emerald-400"
        href="/"
      >
        Home
      </a>
      <a
        class="rounded-md border border-gray-700 px-4 py-2 text-sm text-gray-200 no-underline transition-colors hover:border-emerald-500 hover:text-emerald-400"
        href="/os"
      >
        Operating Systems
      </a>
      <a
        class="rounded-md border border-gray-700 px-4 py-2 text-sm text-gray-200 no-underline transition-colors hover:border-emerald-500 hover:text-emerald-400"
        href="/tools"
      >
        Tools
      </a>
    </div>
  </div>
</BaseLayout>
