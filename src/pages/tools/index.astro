---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('tools');
const categoryCounts = new Map<string, number>();
for (const entry of entries) {
  for (const c of entry.data.categories) {
    categoryCounts.set(c, (categoryCounts.get(c) ?? 0) + 1);
  }
}
const categories = [...categoryCounts.keys()].sort();
---

<BaseLayout title="Tools">
  <h1>Tools ({entries.length})</h1>
  <p>
    Individual pentesting tools, synced from{' '}
    <a href="https://www.kali.org/tools/all-tools/" rel="noopener noreferrer" target="_blank">Kali's official tool list</a>{' '}
    — searchable by name and filterable by category/purpose.
  </p>

  <input
    id="name-filter"
    class="search-input"
    type="search"
    placeholder="Filter by name…"
    aria-label="Filter tools by name"
  />

  <label for="category-filter" class="filter-label">Category</label>
  <select id="category-filter" class="filter-select">
    <option value="all">All categories ({entries.length})</option>
    {categories.map((c) => (
      <option value={c}>{c} ({categoryCounts.get(c)})</option>
    ))}
  </select>

  <p id="result-count" class="last-verified"></p>

  <div class="card-grid" id="card-grid">
    {entries.map((entry) => (
      <a
        class="card"
        href={`/tools/${entry.id}`}
        data-categories={entry.data.categories.join(',')}
        data-name={entry.data.name.toLowerCase()}
      >
        <h3>{entry.data.name}</h3>
        <p>{entry.data.tagline}</p>
        {entry.data.categories.map((c) => <span class="tag">{c}</span>)}
      </a>
    ))}
  </div>
</BaseLayout>

<script>
  const nameFilter = document.getElementById('name-filter') as HTMLInputElement;
  const categoryFilter = document.getElementById('category-filter') as HTMLSelectElement;
  const resultCount = document.getElementById('result-count') as HTMLParagraphElement;
  const cards = [...document.querySelectorAll<HTMLAnchorElement>('#card-grid .card')];

  function applyFilters() {
    const name = nameFilter.value.trim().toLowerCase();
    const category = categoryFilter.value;
    let visible = 0;
    for (const card of cards) {
      const matchesName = !name || (card.dataset.name ?? '').includes(name);
      const cardCategories = (card.dataset.categories ?? '').split(',');
      const matchesCategory = category === 'all' || cardCategories.includes(category);
      const show = matchesName && matchesCategory;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    }
    resultCount.textContent = `Showing ${visible} of ${cards.length} tools`;
  }

  nameFilter.addEventListener('input', applyFilters);
  categoryFilter.addEventListener('change', applyFilters);
  applyFilters();
</script>
