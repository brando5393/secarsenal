---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import { getCollection } from 'astro:content';
import { getToolTeam } from '../../lib/toolTeam';

const entries = await getCollection('tools');
const categoryCounts = new Map<string, number>();
for (const entry of entries) {
  for (const c of entry.data.categories) {
    categoryCounts.set(c, (categoryCounts.get(c) ?? 0) + 1);
  }
}
const categories = [...categoryCounts.keys()].sort();

const INPUT_CLASS =
  'w-full rounded-lg border border-gray-700 bg-gray-900 px-3 py-2.5 text-gray-100 placeholder-gray-500 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500';

const TEAM_LABELS: Record<string, string> = { red: 'Red Team', blue: 'Blue Team' };
const TEAM_BADGE_CLASSES: Record<string, string> = {
  red: 'bg-red-950/60 text-red-400',
  blue: 'bg-blue-950/60 text-blue-400',
};
---

<BaseLayout title="Tools">
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Tools' }]} />
  <h1 class="text-3xl font-bold text-white">Tools ({entries.length})</h1>
  <p class="mt-3 text-gray-300">
    Individual pentesting tools, auto-synced from each official tool listing
    documented in the project's{' '}
    <a class="text-emerald-400 hover:text-emerald-300" href="https://github.com/brando5393/secarsenal#readme" rel="noopener noreferrer" target="_blank">README</a>{' '}
    — searchable by name and filterable by category/purpose.
    {' '}<a class="text-emerald-400 hover:text-emerald-300" href="/categories">What do the badge icons mean?</a>
  </p>

  <input
    id="name-filter"
    class={`mt-4 ${INPUT_CLASS}`}
    type="search"
    placeholder="Filter by name…"
    aria-label="Filter tools by name"
  />

  <label for="category-filter" class="mt-4 block text-sm text-gray-400">Category</label>
  <select
    id="category-filter"
    class={`mt-1 max-w-sm ${INPUT_CLASS}`}
  >
    <option value="all">All categories ({entries.length})</option>
    {categories.map((c) => (
      <option value={c}>{c} ({categoryCounts.get(c)})</option>
    ))}
  </select>

  <div class="mt-4 flex flex-wrap items-center gap-2" id="team-filter-bar" data-default="all">
    <span class="mr-1 text-xs uppercase tracking-wide text-gray-400">Team (best effort)</span>
    <button
      type="button"
      aria-pressed="true"
      data-team="all"
      class="rounded-full border border-gray-700 bg-gray-900 px-3 py-1.5 text-sm text-gray-300 transition-colors aria-pressed:border-emerald-500 aria-pressed:text-white"
      >All</button
    >
    {(['red', 'blue'] as const).map((t) => (
      <button
        type="button"
        aria-pressed="false"
        data-team={t}
        class="rounded-full border border-gray-700 bg-gray-900 px-3 py-1.5 text-sm text-gray-300 transition-colors aria-pressed:border-emerald-500 aria-pressed:text-white"
        >{TEAM_LABELS[t]}</button
      >
    ))}
  </div>
  <p class="mt-1 text-xs text-gray-400">
    Team is guessed from each tool's category tags (falling back to the team of the OS it's
    bundled with) — not sourced from Kali/BlackArch/etc.'s own taxonomy, since none of them tag
    tools by team. A handful of generic desktop apps bundled with privacy-focused OSes like Tails
    (GIMP, LibreOffice) aren't team tools at all and are left unclassified rather than guessed.
  </p>

  <p id="result-count" class="mt-3 text-sm text-gray-400"></p>

  <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3" id="card-grid">
    {entries.map((entry) => {
      const team = getToolTeam(entry.data.categories, entry.data.commonlyOn);
      return (
        <a
          class="card block rounded-lg border border-gray-800 bg-gray-900 p-5 no-underline transition-colors hover:border-emerald-500"
          href={`/tools/${entry.id}`}
          data-categories={entry.data.categories.join(',')}
          data-team={team ?? ''}
          data-name={entry.data.name.toLowerCase()}
        >
          <div class="mb-3 flex items-center gap-3">
            <ToolIcon slug={entry.id} category={entry.data.categories} />
            <h3 class="font-semibold text-white">{entry.data.name}</h3>
          </div>
          <p class="text-sm text-gray-400">{entry.data.tagline}</p>
          <div class="mt-2">
            {entry.data.categories.map((c) => <span class="mr-2 mt-1 inline-block rounded-full bg-gray-800 px-3 py-1 text-xs text-gray-300">{c}</span>)}
            {team && <span class={`mr-2 mt-1 inline-block rounded-full px-3 py-1 text-xs ${TEAM_BADGE_CLASSES[team]}`}>{TEAM_LABELS[team]}</span>}
          </div>
        </a>
      );
    })}
  </div>
</BaseLayout>
