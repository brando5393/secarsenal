---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import OsIcon from '../../components/OsIcon.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('tools');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const osEntries = await getCollection('os');
const hostOs = osEntries.filter((o) => data.commonlyOn.includes(o.data.name));

const SOURCE_LINK_CLASS =
  'inline-flex items-center gap-1 rounded-md border border-gray-700 px-3 py-1.5 text-sm text-gray-200 no-underline transition-colors hover:border-emerald-500 hover:text-emerald-400';
---

<BaseLayout title={data.name} description={data.tagline}>
  <!-- Read by public/scripts/site.js to record a category visit for
       the homepage's "top categories" personalization (localStorage-only,
       per-visitor, never sent anywhere). -->
  <div id="page-meta" data-categories={data.categories.join(',')} hidden></div>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Tools', href: '/tools' }, { label: data.name }]} />
  <div class="flex items-center gap-4">
    <ToolIcon slug={entry.id} category={data.categories} size="lg" />
    <div>
      <h1 class="text-3xl font-bold text-white">{data.name}</h1>
      <p class="mt-1 text-gray-300">{data.tagline}</p>
    </div>
  </div>
  <div class="mt-3">
    {data.categories.map((c) => <span class="mr-2 mt-1 inline-block rounded-full bg-gray-800 px-3 py-1 text-xs text-gray-300">{c}</span>)}
  </div>

  <div class="mt-5 flex flex-wrap gap-3">
    <a class={SOURCE_LINK_CLASS} href={data.docsUrl} rel="noopener noreferrer" target="_blank">Official docs ↗</a>
    {data.downloadUrl && (
      <a class={SOURCE_LINK_CLASS} href={data.downloadUrl} rel="noopener noreferrer" target="_blank">Download ↗</a>
    )}
    {data.repoUrl && (
      <a class={SOURCE_LINK_CLASS} href={data.repoUrl} rel="noopener noreferrer" target="_blank">Source repo ↗</a>
    )}
  </div>
  <p class="mt-3 text-sm text-gray-500">
    Platforms: {data.platforms.join(', ')}{data.license && <> · License: {data.license}</>} · Last verified {data.lastVerified.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
  </p>

  <div class="mt-6 text-gray-300 leading-relaxed [&>p]:mb-4">
    <Content />
  </div>

  <h2 class="mt-8 text-xl font-semibold text-white">Getting started</h2>
  <p class="getting-started mt-3 text-gray-300 leading-relaxed">{data.gettingStarted}</p>

  {hostOs.length > 0 && (
    <>
      <h2 class="mt-8 text-xl font-semibold text-white">Commonly preinstalled on</h2>
      <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3">
        {hostOs.map((os) => (
          <a
            class="card block rounded-lg border border-gray-800 bg-gray-900 p-5 no-underline transition-colors hover:border-emerald-500"
            href={`/os/${os.id}`}
          >
            <div class="mb-3 flex items-center gap-3">
              <OsIcon slug={os.id} category={os.data.category} />
              <h3 class="font-semibold text-white">{os.data.name}</h3>
            </div>
            <p class="text-sm text-gray-400">{os.data.tagline}</p>
          </a>
        ))}
      </div>
    </>
  )}
</BaseLayout>
