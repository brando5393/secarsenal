---
import BaseLayout from '../layouts/BaseLayout.astro';
import OsIcon from '../components/OsIcon.astro';
import ToolIcon from '../components/ToolIcon.astro';
import CategoryBadge from '../components/CategoryBadge.astro';
import { getCollection } from 'astro:content';

const osEntries = await getCollection('os');
const toolEntries = await getCollection('tools');

// Global "top categories" ranking, used as the default for first-time
// visitors and as the pool that client-side personalization (see
// public/scripts/site.js) reorders based on the visitor's own browsing
// history in localStorage. "uncategorized" is excluded since it's a
// parsing artifact, not a real category someone would browse by.
const categoryCounts = new Map<string, number>();
for (const entry of toolEntries) {
  for (const c of entry.data.categories) {
    if (c === 'uncategorized') continue;
    categoryCounts.set(c, (categoryCounts.get(c) ?? 0) + 1);
  }
}
const topCategories = [...categoryCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 12);

// The tools collection has ~780 entries (synced from Kali's full tool
// list) — far too many to render on the homepage. Show a small,
// well-known sample here and send everyone else to /tools.
const FEATURED_SLUGS = [
  'nmap',
  'metasploit-framework',
  'wireshark',
  'burpsuite',
  'hashcat',
  'aircrack-ng',
];
const featuredTools = FEATURED_SLUGS.map((slug) => toolEntries.find((e) => e.id === slug)).filter(
  (e) => e !== undefined
);

const CARD_CLASS =
  'card block rounded-lg border border-gray-800 bg-gray-900 p-5 no-underline transition-colors hover:border-emerald-500';
---

<BaseLayout title="Home">
  <h1 class="text-3xl font-bold text-white">SecArsenal</h1>
  <p class="mt-3 text-gray-300">
    A searchable reference for penetration-testing operating systems and
    tools: what they are, what they're for, and where to get the real
    thing from the official source.
  </p>

  <input
    id="site-search"
    class="mt-4 w-full rounded-lg border border-gray-700 bg-gray-900 px-3 py-2.5 text-gray-100 placeholder-gray-500 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500"
    type="search"
    placeholder="Search tools and operating systems…"
    aria-label="Search"
  />
  <div id="search-results" class="mt-3 grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3"></div>

  <h2 class="mt-10 text-xl font-semibold text-white">Top categories</h2>
  <p id="top-categories-subtitle" class="mt-1 text-sm text-gray-400">Most-represented categories across the tools collection.</p>
  <div id="top-categories-widget" class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-5">
    {topCategories.map(([category, count], i) => (
      <a
        href={`/tools?category=${encodeURIComponent(category)}`}
        data-category={category}
        data-count={count}
        class:list={['card flex items-center gap-3 rounded-lg border border-gray-800 bg-gray-900 p-3 no-underline transition-colors hover:border-emerald-500', { hidden: i >= 5 }]}
      >
        <CategoryBadge category={category} size="sm" />
        <span class="min-w-0">
          <span class="block truncate text-sm font-medium text-white">{category}</span>
          <span class="block text-xs text-gray-500">{count} tools</span>
        </span>
      </a>
    ))}
  </div>

  <h2 class="mt-10 text-xl font-semibold text-white">Operating Systems ({osEntries.length})</h2>
  <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3">
    {osEntries.map((entry) => (
      <a class={CARD_CLASS} href={`/os/${entry.id}`}>
        <div class="mb-3 flex items-center gap-3">
          <OsIcon slug={entry.id} category={entry.data.category} />
          <h3 class="font-semibold text-white">{entry.data.name}</h3>
        </div>
        <p class="text-sm text-gray-400">{entry.data.tagline}</p>
      </a>
    ))}
  </div>
  <p class="mt-3"><a class="text-emerald-400 hover:text-emerald-300" href="/os">Browse all operating systems →</a></p>

  <h2 class="mt-10 text-xl font-semibold text-white">Tools ({toolEntries.length})</h2>
  <p class="mt-1 text-sm text-gray-400">Synced from Kali's, BlackArch's, REMnux's, and Tails' own official tool lists. A few well-known examples:</p>
  <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3">
    {featuredTools.map((entry) => (
      <a class={CARD_CLASS} href={`/tools/${entry.id}`}>
        <div class="mb-3 flex items-center gap-3">
          <ToolIcon slug={entry.id} category={entry.data.categories} />
          <h3 class="font-semibold text-white">{entry.data.name}</h3>
        </div>
        <p class="text-sm text-gray-400">{entry.data.tagline}</p>
      </a>
    ))}
  </div>
  <p class="mt-3"><a class="text-emerald-400 hover:text-emerald-300" href="/tools">Browse all {toolEntries.length} tools →</a></p>
</BaseLayout>
