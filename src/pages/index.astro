---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const osEntries = await getCollection('os');
const toolEntries = await getCollection('tools');

// The tools collection has ~780 entries (synced from Kali's full tool
// list) — far too many to render on the homepage. Show a small,
// well-known sample here and send everyone else to /tools.
const FEATURED_SLUGS = [
  'nmap',
  'metasploit-framework',
  'wireshark',
  'burpsuite',
  'hashcat',
  'aircrack-ng',
];
const featuredTools = FEATURED_SLUGS.map((slug) => toolEntries.find((e) => e.id === slug)).filter(
  (e) => e !== undefined
);

const CARD_CLASS =
  'card block rounded-lg border border-gray-800 bg-gray-900 p-5 no-underline transition-colors hover:border-emerald-500';
---

<BaseLayout title="Home">
  <h1 class="text-3xl font-bold text-white">SecArsenal</h1>
  <p class="mt-3 text-gray-300">
    A searchable reference for penetration-testing operating systems and
    tools: what they are, what they're for, and where to get the real
    thing from the official source.
  </p>

  <input
    id="site-search"
    class="mt-4 w-full rounded-lg border border-gray-700 bg-gray-900 px-3 py-2.5 text-gray-100 placeholder-gray-500 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500"
    type="search"
    placeholder="Search tools and operating systems…"
    aria-label="Search"
  />
  <div id="search-results" class="mt-3 grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3"></div>

  <h2 class="mt-10 text-xl font-semibold text-white">Operating Systems ({osEntries.length})</h2>
  <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3">
    {osEntries.map((entry) => (
      <a class={CARD_CLASS} href={`/os/${entry.id}`}>
        <h3 class="mb-1 font-semibold text-white">{entry.data.name}</h3>
        <p class="text-sm text-gray-400">{entry.data.tagline}</p>
      </a>
    ))}
  </div>
  <p class="mt-3"><a class="text-emerald-400 hover:text-emerald-300" href="/os">Browse all operating systems →</a></p>

  <h2 class="mt-10 text-xl font-semibold text-white">Tools ({toolEntries.length})</h2>
  <p class="mt-1 text-sm text-gray-400">Synced from Kali's, BlackArch's, REMnux's, and Tails' own official tool lists. A few well-known examples:</p>
  <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3">
    {featuredTools.map((entry) => (
      <a class={CARD_CLASS} href={`/tools/${entry.id}`}>
        <h3 class="mb-1 font-semibold text-white">{entry.data.name}</h3>
        <p class="text-sm text-gray-400">{entry.data.tagline}</p>
      </a>
    ))}
  </div>
  <p class="mt-3"><a class="text-emerald-400 hover:text-emerald-300" href="/tools">Browse all {toolEntries.length} tools →</a></p>
</BaseLayout>
