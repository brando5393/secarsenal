---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const osEntries = await getCollection('os');
const toolEntries = await getCollection('tools');

// The tools collection has ~780 entries (synced from Kali's full tool
// list) — far too many to render on the homepage. Show a small,
// well-known sample here and send everyone else to /tools.
const FEATURED_SLUGS = [
  'nmap',
  'metasploit-framework',
  'wireshark',
  'burpsuite',
  'hashcat',
  'aircrack-ng',
];
const featuredTools = FEATURED_SLUGS.map((slug) => toolEntries.find((e) => e.id === slug)).filter(
  (e) => e !== undefined
);
---

<BaseLayout title="Home">
  <h1>SecArsenal</h1>
  <p>
    A searchable reference for penetration-testing operating systems and
    tools: what they are, what they're for, and where to get the real
    thing from the official source.
  </p>

  <input
    id="site-search"
    class="search-input"
    type="search"
    placeholder="Search tools and operating systems…"
    aria-label="Search"
  />
  <div id="search-results"></div>

  <h2>Operating Systems ({osEntries.length})</h2>
  <div class="card-grid">
    {osEntries.map((entry) => (
      <a class="card" href={`/os/${entry.id}`}>
        <h3>{entry.data.name}</h3>
        <p>{entry.data.tagline}</p>
      </a>
    ))}
  </div>
  <p><a href="/os">Browse all operating systems →</a></p>

  <h2>Tools ({toolEntries.length})</h2>
  <p>Synced from Kali's own official tool list. A few well-known examples:</p>
  <div class="card-grid">
    {featuredTools.map((entry) => (
      <a class="card" href={`/tools/${entry.id}`}>
        <h3>{entry.data.name}</h3>
        <p>{entry.data.tagline}</p>
      </a>
    ))}
  </div>
  <p><a href="/tools">Browse all {toolEntries.length} tools →</a></p>
</BaseLayout>

<script>
  const input = document.getElementById('site-search') as HTMLInputElement;
  const results = document.getElementById('search-results') as HTMLDivElement;
  let pagefind: any;

  input.addEventListener('focus', async () => {
    if (!pagefind) {
      // Generated by the pagefind postbuild step, so it doesn't exist at
      // dev/build time. Building the specifier from a variable (not a
      // string literal) keeps Vite from statically resolving it.
      const pagefindPath = '/pagefind' + '/pagefind.js';
      // @ts-ignore
      pagefind = await import(/* @vite-ignore */ pagefindPath).catch(() => null);
    }
  });

  input.addEventListener('input', async () => {
    const query = input.value.trim();
    results.innerHTML = '';
    if (!query) return;
    if (!pagefind) {
      results.innerHTML = '<p class="last-verified">Search index only available in a production build (npm run build).</p>';
      return;
    }
    const search = await pagefind.search(query);
    const items = await Promise.all(search.results.slice(0, 10).map((r: any) => r.data()));
    results.innerHTML = items
      .map(
        (item: any) =>
          `<a class="card" href="${item.url}"><h3>${item.meta?.title ?? item.url}</h3><p>${item.excerpt}</p></a>`
      )
      .join('');
  });
</script>
