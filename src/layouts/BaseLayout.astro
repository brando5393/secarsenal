---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description = 'A reference catalog of pentesting operating systems and tools for infosec professionals.',
  structuredData,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og-image.png', Astro.site);
const pageTitle = `${title} · SecArsenal`;

// `<script>` is an HTML "raw text" element — the parser never decodes
// entities inside it, so Astro's normal `{expr}` text-escaping would
// leave literal "&lt;" in the output and break JSON.parse. set:html is
// required to emit the JSON literally, which means *we* must guard
// against a "</script>" (or any "<") in the data breaking out of the
// tag early — escaping every `<` to its unicode form is the standard
// safe technique and is valid inside any JSON string.
const structuredDataJson = structuredData ? JSON.stringify(structuredData).replace(/</g, '\\u003c') : undefined;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#030712" />
    <link rel="canonical" href={canonicalURL} />
    <!--
      Defense-in-depth CSP while running locally with no server to send
      real headers. The authoritative CSP + other security headers ship
      via the hosting platform config (see SECURITY.md) once deployed.
    -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none';"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="SecArsenal — Operating Systems" href="/rss.xml" />
    <title>{pageTitle}</title>
    {structuredDataJson && <script type="application/ld+json" set:html={structuredDataJson} />}

    <!-- Open Graph / Twitter Card — how the link looks when shared on
         Discord, Slack, X, etc. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SecArsenal" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
  </head>
  <body class="bg-gray-950 text-gray-100 [background-image:radial-gradient(circle_at_1px_1px,theme(colors.gray.800)_1px,transparent_0)] [background-size:28px_28px]">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-emerald-500 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-gray-950"
    >
      Skip to content
    </a>
    <header class="binary-bg sticky top-0 z-10 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-b border-emerald-500/10 bg-gray-950/80 px-4 py-3 backdrop-blur-md sm:px-6 sm:py-4">
      <a class="flex items-center gap-2.5 no-underline" href="/">
        <img src="/logo.svg" alt="" width="28" height="28" class="drop-shadow-[0_0_6px_rgba(52,211,153,0.35)]" />
        <span class="font-heading text-lg font-bold tracking-tight text-white">SecArsenal</span>
      </a>
      <nav class="flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs uppercase tracking-wider sm:gap-6">
        <a class="text-gray-400 no-underline transition-colors hover:text-emerald-400" href="/os">Operating Systems</a>
        <a class="text-gray-400 no-underline transition-colors hover:text-emerald-400" href="/tools">Tools</a>
        <a class="text-gray-400 no-underline transition-colors hover:text-emerald-400" href="/disclaimer">Disclaimer</a>
      </nav>
    </header>

    <div class="border-b border-amber-800/60 bg-amber-950/40 px-6 py-2 text-center text-sm text-amber-200" role="note">
      Educational and ethical use only. Only test systems you own or are
      explicitly authorized to test. Full <a class="text-amber-200 underline hover:text-amber-100" href="/disclaimer">disclaimer</a>.
    </div>

    <main id="main-content" class="mx-auto max-w-4xl px-6 py-8 pb-16" data-pagefind-body>
      <slot />
    </main>

    <footer class="binary-bg border-t border-gray-800 px-6 py-8 text-center text-xs text-gray-400">
      <p>
        SecArsenal is an independent, educational reference. It is not
        affiliated with the projects it documents. All external links go to
        the official, authoritative sources for each tool or distribution.
      </p>

      <nav aria-label="Footer" class="mt-4 flex flex-wrap items-center justify-center gap-x-4 gap-y-1.5">
        <a class="text-gray-400 no-underline transition-colors hover:text-emerald-400" href="/disclaimer">Disclaimer</a>
        <span aria-hidden="true" class="text-gray-800">·</span>
        <a class="text-gray-400 no-underline transition-colors hover:text-emerald-400" href="/privacy">Privacy Policy</a>
        <span aria-hidden="true" class="text-gray-800">·</span>
        <a class="text-gray-400 no-underline transition-colors hover:text-emerald-400" href="/categories">Category Key</a>
        <span aria-hidden="true" class="text-gray-800">·</span>
        <a class="text-gray-400 no-underline transition-colors hover:text-emerald-400" href="/rss.xml">RSS</a>
        <span aria-hidden="true" class="text-gray-800">·</span>
        <a class="text-gray-400 no-underline transition-colors hover:text-emerald-400" href="https://github.com/brando5393/secarsenal" rel="noopener noreferrer" target="_blank">GitHub ↗</a>
        <span aria-hidden="true" class="text-gray-800">·</span>
        <a class="text-gray-400 no-underline transition-colors hover:text-emerald-400" href="https://github.com/brando5393/secarsenal/blob/master/CONTRIBUTING.md" rel="noopener noreferrer" target="_blank">Contribute ↗</a>
      </nav>

      <p class="mt-4">
        © {new Date().getFullYear()} SecArsenal contributors. Code licensed
        <a class="text-emerald-400 hover:text-emerald-300" href="https://opensource.org/licenses/MIT" rel="noopener noreferrer">MIT</a>,
        content licensed <a class="text-emerald-400 hover:text-emerald-300" href="https://creativecommons.org/licenses/by/4.0/" rel="noopener noreferrer">CC BY 4.0</a>.
      </p>
    </footer>

    <div
      id="ack-modal"
      hidden
      role="alertdialog"
      aria-modal="true"
      aria-labelledby="ack-modal-title"
      class="fixed inset-0 z-50 items-center justify-center bg-black/70 p-4 backdrop-blur-sm"
    >
      <div class="max-w-lg rounded-lg border border-gray-800 bg-gray-900 p-6 shadow-2xl">
        <h2 id="ack-modal-title" class="font-heading text-lg font-bold text-white">Before you continue</h2>
        <p class="mt-3 text-sm leading-relaxed text-gray-300">
          SecArsenal is an independent, educational reference. It does not
          host, distribute, or provide exploit code — only descriptions of,
          and links to, publicly available third-party tools and operating
          systems.
        </p>
        <p class="mt-3 text-sm leading-relaxed text-gray-300">
          By continuing, you acknowledge that you will only use the tools
          and techniques referenced on this site against systems, networks,
          or accounts you own or are explicitly authorized to test; that
          unauthorized access to computer systems may be illegal in your
          jurisdiction; and that all information is provided "as is," and
          that SecArsenal and its contributors assume no liability for how
          it is used.
        </p>
        <div class="mt-5 flex flex-wrap items-center gap-4">
          <button
            id="ack-modal-accept"
            type="button"
            class="rounded-md bg-emerald-500 px-4 py-2 text-sm font-semibold text-gray-950 transition-colors hover:bg-emerald-400"
          >
            I understand — continue
          </button>
          <a class="text-sm text-gray-400 underline hover:text-gray-200" href="/disclaimer">Read the full disclaimer</a>
        </div>
      </div>
    </div>

    <script is:inline src="/scripts/site.js"></script>
  </body>
</html>
