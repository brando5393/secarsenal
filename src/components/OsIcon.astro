---
import CategoryBadge from './CategoryBadge.astro';
import CategoryIcon from './CategoryIcon.astro';
import { getCategoryBucket } from '../lib/categoryIcons';
import { OS_LOGOS } from '../lib/osLogos';

interface Props {
  slug: string;
  category: string;
  size?: 'sm' | 'md' | 'lg';
}

const { slug, category, size = 'md' } = Astro.props;
const logo = OS_LOGOS[slug];

const sizeClasses = { sm: 'h-6 w-6', md: 'h-9 w-9', lg: 'h-14 w-14' }[size];
const bgClass = logo?.needsLightBg ? 'bg-white/95 p-1' : '';
const bucket = getCategoryBucket(category);
---

{logo ? (
  <span class="relative inline-flex shrink-0">
    <span class={`inline-flex items-center justify-center rounded-lg ${bgClass} ${sizeClasses}`}>
      <img src={logo.path} alt="" class="h-full w-full object-contain" loading="lazy" />
    </span>
    {/* A real logo replaces the category badge as the main icon, but the
    category it represents shouldn't disappear entirely — a small corner
    badge keeps it visible everywhere, not just on logoless entries. */}
    <span class="absolute -bottom-1 -right-1 rounded-full ring-2 ring-gray-950">
      <CategoryIcon icon={bucket.icon} color={bucket.color} size="xs" />
    </span>
  </span>
) : (
  <CategoryBadge category={category} size={size} />
)}
