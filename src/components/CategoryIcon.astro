---
// Pure icon+color rendering for a resolved category bucket (see
// src/lib/categoryIcons.ts). Split out from CategoryBadge so the
// category-key page (src/pages/categories.astro) can render every
// bucket directly without needing a real category string to resolve.
import bug from '../icons/bug.svg?raw';
import database from '../icons/database.svg?raw';
import dices from '../icons/dices.svg?raw';
import fileText from '../icons/file-text.svg?raw';
import fingerprint from '../icons/fingerprint.svg?raw';
import globe from '../icons/globe.svg?raw';
import key from '../icons/key.svg?raw';
import lock from '../icons/lock.svg?raw';
import network from '../icons/network.svg?raw';
import radar from '../icons/radar.svg?raw';
import search from '../icons/search.svg?raw';
import settings from '../icons/settings.svg?raw';
import shield from '../icons/shield.svg?raw';
import skull from '../icons/skull.svg?raw';
import smartphone from '../icons/smartphone.svg?raw';
import terminal from '../icons/terminal.svg?raw';
import users from '../icons/users.svg?raw';
import waypoints from '../icons/waypoints.svg?raw';
import wifi from '../icons/wifi.svg?raw';
import wrench from '../icons/wrench.svg?raw';
import { BADGE_COLOR_CLASSES } from '../lib/categoryIcons';

const ICONS: Record<string, string> = {
  bug,
  database,
  dices,
  'file-text': fileText,
  fingerprint,
  globe,
  key,
  lock,
  network,
  radar,
  search,
  settings,
  shield,
  skull,
  smartphone,
  terminal,
  users,
  waypoints,
  wifi,
  wrench,
};

interface Props {
  icon: string;
  color: string;
  size?: 'xs' | 'sm' | 'md' | 'lg';
}

const { icon, color, size = 'md' } = Astro.props;
const svg = ICONS[icon] ?? ICONS.wrench;
const colorClass = BADGE_COLOR_CLASSES[color] ?? BADGE_COLOR_CLASSES.gray;

const sizeClasses = {
  xs: 'h-4 w-4 [&_svg]:h-2.5 [&_svg]:w-2.5',
  sm: 'h-6 w-6 [&_svg]:h-3.5 [&_svg]:w-3.5',
  md: 'h-9 w-9 [&_svg]:h-5 [&_svg]:w-5',
  lg: 'h-14 w-14 [&_svg]:h-7 [&_svg]:w-7',
}[size];
---

<span class={`inline-flex shrink-0 items-center justify-center rounded-lg ${colorClass} ${sizeClasses}`} set:html={svg} />
