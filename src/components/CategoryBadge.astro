---
import CategoryIcon from './CategoryIcon.astro';
import { getCategoryBucket, getCategoryBucketForList } from '../lib/categoryIcons';

interface Props {
  category: string | string[];
  size?: 'sm' | 'md' | 'lg';
  showLabel?: boolean;
}

const { category, size = 'md', showLabel = false } = Astro.props;
const bucket = Array.isArray(category) ? getCategoryBucketForList(category) : getCategoryBucket(category);
const titleText = Array.isArray(category) ? category.join(', ') : category;
---

<span class="inline-flex items-center gap-2" role="img" aria-label={titleText} title={titleText}>
  <span aria-hidden="true">
    <CategoryIcon icon={bucket.icon} color={bucket.color} size={size} />
  </span>
  {showLabel && <span class="text-sm text-gray-300" aria-hidden="true">{titleText}</span>}
</span>
